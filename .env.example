# ============================================
# Frontend Environment Variables (CRA)
# ============================================

# API base URL used by src/services/apiClient.js
# Local dev (recommended): keep /api and rely on package.json proxy -> http://localhost:8080
REACT_APP_API_BASE_URL=/api

# Optional: build metadata
REACT_APP_APP_NAME=Mini PLM
REACT_APP_APP_VERSION=1.0.0
